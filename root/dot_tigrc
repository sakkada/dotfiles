# Tig configuration
# https://github.com/jonas/tig/blob/master/doc/tigrc.5.adoc
# https://github.com/jonas/tig/wiki/Bindings
# https://github.com/typebrook/settings/blob/dev/tigrc
# https://jonas.github.io/tig/

set main-view = line-number:no,interval=5 id:yes date:default author:full commit-title:yes,graph,refs,overflow=no
set refs-view = line-number:no id:yes date:default author:full ref commit-title

set status-show-untracked-files = yes
set commit-order = auto  # Enum: auto (default), default, topo, date, reverse (main)
set line-graphics = utf-8  # Enum: ascii, default, utf-8, auto
# set diff-highlight = true

bind generic y none
bind generic yy view-stash

bind generic <ShiftLeft> :toggle split-view-width +5%
bind generic <ShiftRight> :toggle split-view-width -5%

bind main B none
bind main Bm !?git merge %(branch) --ff-only
bind main BM !?git merge %(repo:remote) --ff-only
bind main BP !?git push %(remote) %(branch)

bind refs <Ctrl-j> !?git checkout %(branch)
bind main <Ctrl-j> !?git checkout %(branch)

# bind generic yt  +sh -c "git log -n 1 %(commit) --format=format:%s | xargs -i sh -c \"echo -n '{}' > /dev/clipboard && echo -n '{}'\"" # without bashclip.sh
bind generic yt    +sh -c "git log -n 1 %(commit) --format=format:%s | bashclip.sh -o 'Copied (title): {}'"                             # commit title
bind generic yT    +sh -c "git log -n 1 %(commit) --format=format:%B | bashclip.sh -o 'Copied (title+body): {}'"                        # commit raw body (multiline)
bind generic yp    +sh -c "git log -n 1 %(commit) --format=format:'hash:  %h%ntitle: %s' --patch | bashclip.sh -o 'Copied patch: {}'"   # commit patch
bind generic ycp   +sh -c "git show %(commit) -- %(file) | bashclip.sh -o 'Copied patch of %(file): {}'"                                # file patch in commit
bind generic ycP   +sh -c "git show %(commit) | bashclip.sh -o 'Copied full patch: {}'"                                                 # full patch in commit (git log --patch doesn't work with stash commits)
bind generic ycF   +sh -c "git show %(branch):%(file) | bashclip.sh -o 'Copied file content: %(file) from %(branch)'"                   # file content in branch
bind generic ycf   +sh -c "echo -n '%(file)' | bashclip.sh -o 'Copied filename: {}'"                                                    # current file name var
bind generic yl    +sh -c "echo -n '%(text)' | bashclip.sh -o 'Copied line: {}'"                                                        # current text line var
bind generic yb    +sh -c "echo -n '%(branch)' | bashclip.sh -o 'Copied branchname: {}'"                                                # current local branch var
bind generic yh    +sh -c "echo -n '%(commit)' | bashclip.sh -o 'Copied commit hash: {}'"                                               # current commit hash var
bind generic yv    !sh -c "printf 'head         -   %(head)\
\\ncommit       -   %(commit) \
\\nblob         -   %(blob) \
\\nbranch       -   %(branch) \
\\nremote       -   %(remote) \
\\ntag          -   %(tag) \
\\nstash        -   %(stash) \
\\ndirectory    -   %(directory) \
\\nfile         -   %(file) \
\\nlineno       -   %(lineno) \
\\nref          -   %(ref) \
\\ntext         -   %(text) \
\\nrepo:head    -   %(repo:head) \
\\nrepo:head-id -   %(repo:head-id) \
\\nrepo:remote  -   %(repo:remote) \
\\nrepo:cdup    -   %(repo:cdup) \
\\nrepo:prefix  -   %(repo:prefix) \
\\nrepo:git-dir -   %(repo:git-dir) \
\\nrepo:isinwtr -   %(repo:is-inside-work-tree) \
' | bashclip.sh -o 'Copied summary info: \\n{}'"                                                                                           # current variables


bind main <Esc>a <tig --all --date-order

# file history commits
bind tree H >sh -c "tig \"$(git rev-parse --show-toplevel)/%(file)\""
bind diff H >sh -c "tig \"$(git rev-parse --show-toplevel)/%(file)\""
bind status H >sh -c "tig \"$(git rev-parse --show-toplevel)/%(file)\""


